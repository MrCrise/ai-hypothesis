POSTGRES_USER=rd_user
POSTGRES_PASSWORD=rd_secret
POSTGRES_DB=metallurgy_rag
DATABASE_URL=postgresql+asyncpg://rd_user:rd_secret@postgres:5432/metallurgy_rag

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=any
S3_SECRET_KEY=any
S3_BUCKET_NAME=papers

# Local LLM Server (llama.cpp)
# Port 8080 avoids collision with services/api (port 8000).
# Tag pin format: server-cuda-bXXXXX for explicit release builds supporting Qwen3.
LLM_BASE_URL=http://llm-server:8080/v1
LLM_API_KEY=EMPTY
LLAMA_CPP_IMAGE_TAG=server-cuda
# Dev profile (12 GB VRAM, hybrid CPU/GPU offload via -ngl): Qwen3.8-27B-UD-Q4_K_M.gguf (or UD-IQ4_XS / UD-Q3_K_XL)
# Prod profile (GPU server, -ngl 99): Qwen3.8-27B-UD-Q4_K_M.gguf or Qwen3.8-27B-UD-Q6_K.gguf
LLM_MODEL_NAME=Qwen3.8-27B
LLM_MODEL_FILE=Qwen3.8-27B-UD-Q4_K_M.gguf
LLM_CTX_SIZE=32768
LLM_GPU_LAYERS=28
LLM_PARALLEL_SLOTS=4
LLM_BG_MAX_CONCURRENCY=3
LLM_REQUEST_TIMEOUT_SECONDS=300.0
# Optional MoE flag for Qwen3-30B-A3B on dev (leave empty for dense models in prod):
# LLAMA_ARG_CPU_MOE=--n-cpu-moe

# ML Inference Service (Qwen3-Embedding & Qwen3-Reranker)
# Port 8081. Dev device: cpu (avoids CUDA VRAM competition). Prod: cuda.
ML_INFERENCE_BASE_URL=http://ml-inference:8081
ML_INFERENCE_DEVICE=cpu
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
ML_BATCH_MAX_SIZE=32
ML_BATCH_MAX_WAIT_MS=10
ML_INFERENCE_TIMEOUT_SECONDS=60.0
TORCH_NUM_THREADS=4

PDF_PARSER_URL=http://pdf-parser:5001
HTTP_PROXY=http://egress-gateway:3128
HTTPS_PROXY=http://egress-gateway:3128
NO_PROXY=localhost,127.0.0.1,postgres,seaweedfs,llm-server,ml-inference,pdf-parser,api

OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=rd@example.com
CORE_API_KEY=
LENS_API_KEY=
